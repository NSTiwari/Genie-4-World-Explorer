# Copy to .env and fill in.

# Paid-tier Gemini API key (Genie 4 is not on the free tier).
GEMINI_API_KEY=

# Google Maps key with Maps JavaScript API, Places API (New) and Street View Static API.
# Restrict it to http://localhost:5000/* under "Websites".
MAPS_API_KEY=

# Optional
# GENIE_MODEL=genie-4
# MAX_SESSION_SECONDS=120
# CREDIT_NAME=Your Name
# PORT=5000
